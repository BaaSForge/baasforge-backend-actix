# ! ====== important Note: Do not use "" or '' (any quotes) in this file!! ======
PORT=1101
APP_ENV=production

DATABASE_URL=postgres://baal:PASSWORD_HERE@localhost:5632/baal_db?sslmode=disable
DATABASE_POOL_SIZE=3
DATABASE_CONNECTION_TIMEOUT_SECS=30

AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=

RABBIT_URL=amqp://baal:PASSWORD_HERE@localhost:5673/%2f
RABBITMQ_MANAGEMENT_URL=http://localhost:15673
RETRY_DELAY_EXCHANGE=retry_delay_exchange
RETRY_DELAY_TTL_MS=3000
# Must exceed worst-case LLM time (thinking only, tools processed as separated queue messages). Queue x-consumer-timeout must match — re-run queue_setup_http.sh after changing.
CHAT_CONSUMER_TIMEOUT_SECS=180
STOPPED_MESSAGES_IDS_CACHE_TTL_SECS=600

OPENAI_API_KEY=
# Model id for /v1/chat/completions. Examples:
# - Fast / general: gpt-4o-mini gpt-4o gpt-4.1 gpt-4.1-mini
# - Reasoning (use OPENAI_REASONING_EFFORT below): gpt-5.4 gpt-5.4-mini gpt-5.4-nano gpt-5.2 gpt-5.1 gpt-5 o4-mini o3 o3-mini o1
# Full list and capabilities: https://platform.openai.com/docs/models and API create-chat-completion model enum.
OPENAI_MODEL=gpt-4o-mini
# Optional. Chat Completions only: sends JSON field reasoning_effort (none, minimal, low, medium, high, xhigh — not all values work on every model).
# Omit or leave empty for non-reasoning models (e.g. gpt-4o-mini). See https://platform.openai.com/docs/guides/reasoning
OPENAI_REASONING_EFFORT=

GEMINI_API_KEY=
# Model id passed to the API (with or without models/ prefix; code normalizes). Examples:
# - Gemini 3: gemini-3-pro-preview gemini-3-flash-preview gemini-3.1-flash-lite-preview
# - Gemini 2.5: gemini-2.5-pro gemini-2.5-flash
# - Aliases / latest: gemini-flash-latest gemini-pro-latest (see Google AI model list)
# Capabilities and exact ids change often: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-pro
# Thought summaries / reasoning (gemini-rust: with_thinking_budget + with_thoughts_included, or with_thinking_level).
# Official guide: https://ai.google.dev/gemini-api/docs/thinking
# GEMINI_THINKING_ENABLED=false forces thinking off even if level/budget are set. Values: true false 1 0 yes no on off
# Gemini 2.5: set GEMINI_THINKING_BUDGET — -1 = dynamic budget; 0 = off (Flash); positive = max thinking tokens (ranges are model-specific).
# Do not set GEMINI_THINKING_LEVEL at the same time as budget (API rejects mixing thinking_level with thinking_budget).
# Gemini 3: set GEMINI_THINKING_LEVEL to minimal low medium high (omit budget). Example: GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_ENABLED=false
GEMINI_THINKING_BUDGET=5000
GEMINI_THINKING_LEVEL=

ANTHROPIC_API_KEY=
# claude-sonnet-4-6 claude-opus-4-6 claude-haiku-4-5
ANTHROPIC_MODEL=claude-haiku-4-5
# Extended thinking: explicit on/off for thinking-capable Claude models. false = off (ignores budget below).
# Omit = same as true; use budget. Values: true false 1 0 yes no on off
ANTHROPIC_THINKING_ENABLED=false
# When thinking is enabled, max thinking token budget (API field budget_tokens). Omit or 0 = off.
ANTHROPIC_THINKING_BUDGET_TOKENS=10000

LLM_PROVIDER=gemini # gemini openai anthropic

REDIS_URL=redis://localhost:6379

RUNTIME_NATS_URL=nats://runtime_nats:PASSWORD_HERE@localhost:4222
RUNTIME_NATS_SUBJECT_RELEASE=runtime.release
RUNTIME_NATS_JETSTREAM_STREAM_RELEASE=RUNTIME_RELEASE
RUNTIME_NATS_JETSTREAM_CONSUMER_RELEASE=release_deploy
RUNTIME_NATS_SUBJECT_ENV=runtime.env
RUNTIME_NATS_JETSTREAM_STREAM_ENV=RUNTIME_ENV
RUNTIME_NATS_JETSTREAM_CONSUMER_ENV=runtime_env_invalidate

UNIT_REVIEWER_SIMULATE_FAILURE=false

BASE_RUNTIME_ENDPOINT=http://localhost:1500

# Jaeger Query base URL (no trailing slash). Used by the observability proxy endpoint
# (see /api/v1/observability/traces) to fetch OpenTelemetry traces by traceID.
JAEGER_QUERY_BASE_URL=http://127.0.0.1:16686

# Dev: fail the (N+1)th LLM generate call per chat session (any provider). 0 or -1 = off.
LLM_SIMULATE_ERROR_AFTER_CALLS=0